# --- Blog admin auth ---
# Generate both values with: npm run hash-password -- "your-strong-password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
AUTH_SECRET=<at-least-32-random-characters>

# --- Blog storage ---
# Required in production (Vercel etc. have a read-only filesystem).
# If unset, posts are stored in data/posts.json (fine for local development).
MONGODB_URI=mongodb+srv://tejas:FBZnLGzOfzFpN7hA@clustermynew.6vdem.mongodb.net/?appName=Clustermynew
MONGODB_DB=portfolio

# --- Image uploads (optional) ---
